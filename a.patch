@@ -0,0 +1,44 @@
+package servicegrpc
+
+import (
+	"context"
+	"net"
+	"testing"
+
+	servicev0 "github.com/moby/moby/v2/extpoints/service/v0"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/protobuf/types/known/wrapperspb"
+	"gotest.tools/v3/assert"
+)
+
+func TestAdaptPreservesUnaryInterceptor(t *testing.T) {
+	intercepted := false
+	srv := grpc.NewServer(grpc.UnaryInterceptor(func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		intercepted = true
+		assert.Equal(t, info.FullMethod, "/example.Greeter/Greet")
+		return handler(ctx, req)
+	}))
+	Register(srv, servicev0.Registration{Service: "example.Greeter", Methods: []servicev0.Method{{
+		Name:       "Greet",
+		NewRequest: func() any { return new(wrapperspb.StringValue) },
+		Handler: func(_ context.Context, req any) (any, error) {
+			return wrapperspb.String("hello " + req.(*wrapperspb.StringValue).Value), nil
+		},
+	}}})
+
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	assert.NilError(t, err)
+	go func() { _ = srv.Serve(lis) }()
+	t.Cleanup(srv.Stop)
+
+	conn, err := grpc.NewClient(lis.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()))
+	assert.NilError(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+
+	out := new(wrapperspb.StringValue)
+	err = NewInvoker(conn).Invoke(context.Background(), "example.Greeter", "Greet", wrapperspb.String("world"), out)
+	assert.NilError(t, err)
+	assert.Equal(t, out.Value, "hello world")
+	assert.Check(t, intercepted)
+}

