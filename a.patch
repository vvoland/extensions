diff --git internal/extensions/servicegrpc/servicegrpc.go internal/extensions/servicegrpc/servicegrpc.go
new file mode 100644
index 0000000000..77b037e200
--- /dev/null
+++ internal/extensions/servicegrpc/servicegrpc.go
@@ -0,0 +1,92 @@
+// Package servicegrpc adapts transport-neutral published extension services to
+// the current gRPC backend.
+package servicegrpc
+
+import (
+	"context"
+
+	servicev0 "github.com/moby/moby/v2/extpoints/service/v0"
+	"github.com/moby/moby/v2/internal/extensions/serverpoint"
+	"google.golang.org/grpc"
+)
+
+// ServerPoint registers typed published services on an SDK gRPC server.
+var ServerPoint = serverpoint.Registration{
+	Point: servicev0.Point.ID(),
+	Register: func(r grpc.ServiceRegistrar, impl any) {
+		impl.(servicev0.Provider).RegisterServices(registrar{target: r})
+	},
+}
+
+// Service is a collected, not-yet-registered gRPC service.
+type Service struct {
+	Name string
+	Desc *grpc.ServiceDesc
+	Impl any
+}
+
+// Adapt converts a transport-neutral registration to a gRPC service.
+func Adapt(registration servicev0.Registration) Service {
+	impl := &server{}
+	desc := &grpc.ServiceDesc{
+		ServiceName: registration.Service,
+		HandlerType: (*serviceServer)(nil),
+		Methods:     make([]grpc.MethodDesc, 0, len(registration.Methods)),
+	}
+	for i := range registration.Methods {
+		method := &registration.Methods[i]
+		desc.Methods = append(desc.Methods, grpc.MethodDesc{
+			MethodName: method.Name,
+			Handler:    unaryHandler(registration.Service, method),
+		})
+	}
+	return Service{Name: registration.Service, Desc: desc, Impl: impl}
+}
+
+// Register adapts registration and registers it on r.
+func Register(r grpc.ServiceRegistrar, registration servicev0.Registration) {
+	service := Adapt(registration)
+	r.RegisterService(service.Desc, service.Impl)
+}
+
+type registrar struct {
+	target grpc.ServiceRegistrar
+}
+
+func (r registrar) RegisterService(registration servicev0.Registration) {
+	Register(r.target, registration)
+}
+
+// NewInvoker adapts a gRPC client connection to a transport-neutral invoker.
+func NewInvoker(conn grpc.ClientConnInterface) servicev0.Invoker {
+	return invoker{conn: conn}
+}
+
+type invoker struct {
+	conn grpc.ClientConnInterface
+}
+
+func (i invoker) Invoke(ctx context.Context, service, method string, request, response any) error {
+	return i.conn.Invoke(ctx, "/"+service+"/"+method, request, response, grpc.StaticMethod())
+}
+
+type serviceServer interface{}
+
+type server struct{}
+
+func unaryHandler(service string, method *servicev0.Method) grpc.MethodHandler {
+	return func(srv any, ctx context.Context, dec func(any) error, interceptor grpc.UnaryServerInterceptor) (any, error) {
+		request := method.NewRequest()
+		if err := dec(request); err != nil {
+			return nil, err
+		}
+		server := srv.(*server)
+		if interceptor == nil {
+			return method.Handler(ctx, request)
+		}
+		info := &grpc.UnaryServerInfo{Server: server, FullMethod: "/" + service + "/" + method.Name}
+		return interceptor(ctx, request, info, func(ctx context.Context, request any) (any, error) {
+			return method.Handler(ctx, request)
+		})
+	}
+}
